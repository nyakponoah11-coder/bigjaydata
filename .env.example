# =====================================================================
# BundleMartGh - Environment Variables
# Copy this file to .env.local and populate with your production keys
# =====================================================================

# NEXT.JS
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# SUPABASE CONFIGURATION
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# PAYSTACK PAYMENT CONFIGURATION
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# DATAMART API CONFIGURATION
DATAMART_API_KEY=your_datamart_api_key_here
DATAMART_API_URL=https://api.datamartgh.com/v1

# ADMIN PANEL AUTHENTICATION
ADMIN_PASSWORD=bundlemart2026
ADMIN_SECRET_KEY=your_admin_secret_key_here
